{
  "name": "hutu.si",
  "private": true,
  "description": "hutu.si — John Hu's bilingual calling card",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "fonts": "node scripts/fonts.mjs",
    "images": "node scripts/images.mjs",
    "og": "node scripts/og.mjs",
    "measure": "node scripts/measure.mjs",
    "deploy": "npm run build && wrangler deploy",
    "align": "node scripts/align.mjs",
    "test:unit": "node --test test/unit/",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "wrangler": "4.152.0"
  }
}
